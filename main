dados_animais = {}
def cadastro_animal(nome, especie, raca, idade, saude, chegada, comportamento):
    dados_animais[nome] = {
        "espécie": especie,
        "raça": raca,
        "idade": idade,
        "saúde": saude,
        "chegada": chegada,
        "comportamento": comportamento
    }
    
    return dados_animais    

print(dados_animais)

